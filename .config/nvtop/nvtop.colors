# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #120d10
selected_bg = #1f171c
header_bg = #2d2329

# Text colors
text = #f2e1ea
selected_text = #e8b9d9
header_text = #b6a7af
inactive_text = #7f727a

# GPU utilization colors (gradient from low to high)
gpu_util_low = #ffd8c5
gpu_util_med = #ffedf0
gpu_util_high = #f197d2

# Memory usage colors
memory_low = #dedcff
memory_med = #e5b6fd
memory_high = #e4a7f1

# Temperature colors (cool to hot)
temp_cool = #ffd8c5
temp_warm = #ffedf0
temp_hot = #f197d2

# Power usage colors
power_low = #ffd8c5
power_med = #ffbad7
power_high = #eaacd1

# Process list colors
process_normal = #f2e1ea
process_highlight = #e8b9d9
process_killed = #f197d2

# Border and separator colors
border = #7f727a
separator = #50454c

# Chart and graph colors
chart_line = #efdfff
chart_fill = #1f171c

# Status indicators
status_ok = #ffd8c5
status_warning = #ffedf0
status_error = #f197d2
status_info = #e4a7f1
