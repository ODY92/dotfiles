* {
  bg:          #0c0f0acc;
  bg-alt:      #1c2119;
  fg:          #e2e7d9;
  muted:       #a8ad9f;
  accent:      #b4cfa0;
  accent-soft: #b4cfa040;
  on-accent:   #304623;
}

configuration { show-icons: false; }

window {
  width: 660px;
  location: center;
  border: 1px;
  border-color: @accent-soft;
  border-radius: 32px;
  background-color: @bg;
  padding: 22px;
}

mainbox {
  children: [inputbar, listview];
  spacing: 20px;
  background-color: transparent;
}

inputbar {
  children: [prompt, entry];
  spacing: 14px;
  padding: 16px 22px;
  border-radius: 22px;
  background-color: @bg-alt;
}

prompt { text-color: @accent; background-color: transparent; }

entry {
  placeholder: "Rechercher un emoji…";
  placeholder-color: @muted;
  text-color: @fg;
  background-color: transparent;
}

listview {
  columns: 8;
  lines: 6;
  fixed-columns: true;
  flow: horizontal;
  fixed-height: true;
  spacing: 10px;
  scrollbar: false;
  background-color: transparent;
}

element {
  padding: 4px;
  border-radius: 20px;
  background-color: transparent;
  text-color: @fg;
}

element selected.normal {
  background-color: @accent-soft;
  border: 2px;
  border-color: @accent;
  text-color: @fg;
}

element-text {
  font: "Apple Color Emoji 22";
  padding: 14px 0px 26px 0px;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  text-color: inherit;
  background-color: transparent;
}
